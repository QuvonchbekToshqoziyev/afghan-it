# Afghan IT Academy — Neon + NestJS + Vercel
# Copy to .env.local for local API work. Do not commit real values.

# Neon pooled URL for runtime and direct URL for Drizzle migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# At least 32 random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m

# Browser/API deployment origins.
WEB_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional server-side AI Mentor integration.
OPENAI_API_KEY=
