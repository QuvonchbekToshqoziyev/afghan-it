{
  "name": "afghan-it-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "web:dev": "npm --workspace @afghan-it/web run dev",
    "web:build": "npm --workspace @afghan-it/web run build",
    "api:dev": "tsx watch apps/api/src/main.ts",
    "db:build": "tsc -p packages/db/tsconfig.json",
    "api:build": "npm run db:build && tsc -p apps/api/tsconfig.json",
    "api:start": "node apps/api/dist/main.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "build": "npm run api:build && npm run web:build"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "next": "16.2.12",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
